{
  "multipart": [
    {
      "apply": {
        "model": "craft:block/frame_core"
      }
    },
    {
      "apply": {
        "model": "craft:block/frame_down"
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/frame_up"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/frame_north"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/frame_south"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/frame_west"
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/frame_east"
      },
      "when": {
        "east": "true"
      }
    }
  ]
}
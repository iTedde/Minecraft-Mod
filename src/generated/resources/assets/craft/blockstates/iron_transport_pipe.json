{
  "multipart": [
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_core"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_down"
      },
      "when": {
        "down": "true",
        "output": "1|2|3|4|5"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_down_output"
      },
      "when": {
        "down": "true",
        "output": "0"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_up"
      },
      "when": {
        "output": "0|2|3|4|5",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_up_output"
      },
      "when": {
        "output": "1",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_north"
      },
      "when": {
        "north": "true",
        "output": "0|1|3|4|5"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_north_output"
      },
      "when": {
        "north": "true",
        "output": "2"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_south"
      },
      "when": {
        "output": "0|1|2|4|5",
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_south_output"
      },
      "when": {
        "output": "3",
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_west"
      },
      "when": {
        "output": "0|1|2|3|5",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_west_output"
      },
      "when": {
        "output": "4",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_east"
      },
      "when": {
        "east": "true",
        "output": "0|1|2|3|4"
      }
    },
    {
      "apply": {
        "model": "craft:block/iron_transport_pipe_east_output"
      },
      "when": {
        "east": "true",
        "output": "5"
      }
    }
  ]
}